{
  "info": {
    "name": "RAG Pipeline",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/health"
      }
    },
    {
      "name": "Ingest PDF",
      "request": {
        "method": "POST",
        "url": "http://localhost:8000/ingest",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "files",
              "type": "file",
              "src": ""
            }
          ]
        }
      }
    },
    {
      "name": "Query",
      "request": {
        "method": "POST",
        "url": "http://localhost:8000/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What is this document about?\"\n}"
        }
      }
    },
    {
      "name": "List Collections",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/collections"
      }
    },
    {
      "name": "Collection Stats",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/collections/rag_documents/stats"
      }
    },
    {
      "name": "Delete Collection",
      "request": {
        "method": "DELETE",
        "url": "http://localhost:8000/collections/rag_documents"
      }
    },
    {
      "name": "Experiment Chunk Sizes",
      "request": {
        "method": "POST",
        "url": "http://localhost:8000/experiment/chunk-sizes",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What is this document about?\"\n}"
        }
      }
    }
  ]
}
